<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context="io.github.msaggik.home.presentation.ui.NewRoomFragment">

    <View
        android:id="@+id/foreground_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/new_room"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="@dimen/dimen_70"
            android:layout_height="@dimen/dimen_70"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:foreground="@drawable/button_round_transparent"
            android:padding="@dimen/dimen_16"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_back"
            android:theme="@style/ButtonThemeOverlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/header"
            style="@style/HeaderTextSecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/new_room"
            app:layout_constraintBottom_toBottomOf="@+id/button_back"
            app:layout_constraintStart_toEndOf="@+id/button_back"
            app:layout_constraintTop_toTopOf="@+id/button_back" />

        <ImageView
            android:id="@+id/image_room"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:layout_marginTop="@dimen/dimen_30"
            android:adjustViewBounds="true"
            android:contentDescription="@string/default_hyphen"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_room_add"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/guideline_horizontal_one"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_horizontal_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.45" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/name_room"
            style="@style/TextInputLayoutRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:hint="@string/name_room_home"
            android:textColorHint="@color/selector_text_input_layout"
            app:boxCornerRadiusBottomEnd="@dimen/dimen_10"
            app:boxCornerRadiusBottomStart="@dimen/dimen_10"
            app:boxCornerRadiusTopEnd="@dimen/dimen_10"
            app:boxCornerRadiusTopStart="@dimen/dimen_10"
            app:boxStrokeColor="@color/selector_text_input_layout"
            app:cursorColor="@color/selector_text_input_layout"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/selector_text_input_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_room">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_room_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:padding="@dimen/dimen_16"
                android:singleLine="true"
                android:textColorHint="@color/app_color_onSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/description_room"
            style="@style/TextInputLayoutRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:hint="@string/description_default"
            android:textColorHint="@color/selector_text_input_layout"
            app:boxCornerRadiusBottomEnd="@dimen/dimen_10"
            app:boxCornerRadiusBottomStart="@dimen/dimen_10"
            app:boxCornerRadiusTopEnd="@dimen/dimen_10"
            app:boxCornerRadiusTopStart="@dimen/dimen_10"
            app:boxStrokeColor="@color/selector_text_input_layout"
            app:cursorColor="@color/selector_text_input_layout"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/selector_text_input_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name_room">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/description_room_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:padding="@dimen/dimen_16"
                android:lines="3"
                android:gravity="start|top"
                android:textColorHint="@color/app_color_onSurface" />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_added_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:paddingStart="@dimen/dimen_24"
            android:clipToPadding="false"
            android:minHeight="50dp"
            android:visibility="visible"
            tools:listitem="@layout/item_added_device"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/description_room" />

        <TextView
            android:id="@+id/button_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:layout_marginBottom="@dimen/dimen_24"
            android:background="@drawable/button_state_drawable"
            android:clickable="true"
            android:enabled="false"
            android:fontFamily="@font/geologica_auto_regular"
            android:gravity="center"
            android:paddingVertical="@dimen/dimen_12"
            android:text="@string/create"
            android:textColor="@color/app_color_onPrimary"
            android:textSize="@dimen/text_size_18s"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_sheet_room"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_bottom_sheet"
        android:orientation="vertical"
        android:visibility="visible"
        app:behavior_hideable="true"
        app:behavior_peekHeight="550dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <TextView
            android:id="@+id/header_two"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/saved_devices"
            android:fontFamily="@font/geologica_auto_medium"
            android:textColor="@color/app_color_onSurface"
            android:textSize="@dimen/text_size_18s"
            android:textFontWeight="350"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_41"
            android:layout_marginHorizontal="@dimen/dimen_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_bluetooth_saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:minHeight="50dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_two" />

        <ProgressBar
            android:id="@+id/loading_device"
            android:layout_width="@dimen/dimen_41"
            android:layout_height="@dimen/dimen_41"
            android:layout_marginTop="@dimen/dimen_50"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/app_color_primary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_two" />

        <TextView
            android:id="@+id/error_message_saved"
            style="@style/HeaderTree"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:layout_marginHorizontal="@dimen/dimen_24"
            android:text="@string/error_message"
            android:textColor="@color/app_color_onBackground"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_two" />

        <TextView
            android:id="@+id/empty_list_devices_saved"
            style="@style/HeaderTree"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_24"
            android:text="@string/empty_list_devices"
            android:textColor="@color/app_color_onBackground"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_two" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>