<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_color_background"
    tools:context="io.github.msaggik.home.presentation.ui.NewLightingModeFragment">

    <ImageView
        android:id="@+id/button_back"
        android:layout_width="@dimen/dimen_70"
        android:layout_height="@dimen/dimen_70"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:foreground="@drawable/button_round_transparent"
        android:padding="@dimen/dimen_16"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_back"
        android:theme="@style/ButtonThemeOverlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/header"
        style="@style/HeaderTextSecond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/new_lighting_mode"
        app:layout_constraintBottom_toBottomOf="@+id/button_back"
        app:layout_constraintStart_toEndOf="@+id/button_back"
        app:layout_constraintTop_toTopOf="@+id/button_back" />

    <ImageView
        android:id="@+id/image_composition"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:layout_marginTop="@dimen/dimen_30"
        android:adjustViewBounds="true"
        android:contentDescription="@string/default_hyphen"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_lighting_mode_add"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/guideline_horizontal"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/name_lighting_mod"
        style="@style/TextInputLayoutRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:hint="@string/name_room_home"
        android:textColorHint="@color/selector_text_input_layout"
        app:boxCornerRadiusBottomEnd="@dimen/dimen_10"
        app:boxCornerRadiusBottomStart="@dimen/dimen_10"
        app:boxCornerRadiusTopEnd="@dimen/dimen_10"
        app:boxCornerRadiusTopStart="@dimen/dimen_10"
        app:boxStrokeColor="@color/selector_text_input_layout"
        app:cursorColor="@color/selector_text_input_layout"
        app:hintAnimationEnabled="true"
        app:hintTextColor="@color/selector_text_input_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_composition">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/name_lighting_mod_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:padding="@dimen/dimen_16"
            android:singleLine="true"
            android:textColorHint="@color/app_color_onSurface" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/colors_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dimen_24"
        app:layout_constraintBottom_toTopOf="@+id/button_create"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_lighting_mod">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.16" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.32" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.48" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.64" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.80" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.96" />

        <ImageView
            android:id="@+id/lighting_color_e"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/shape_view_color"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_f"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical_d"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/lighting_color_d"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/shape_view_color"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_e"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical_c"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/lighting_color_c"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/shape_view_color"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_d"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical_b"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/lighting_color_b"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/shape_view_color"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_c"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical_a"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/lighting_color_a"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/shape_view_color"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_b"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/loading_colors"
        android:layout_width="@dimen/dimen_41"
        android:layout_height="@dimen/dimen_41"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/app_color_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/button_create"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_lighting_mod" />

    <TextView
        android:id="@+id/error_message_colors"
        style="@style/HeaderTree"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:text="@string/error_message"
        android:textColor="@color/app_color_onBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/button_create"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_lighting_mod" />

    <TextView
        android:id="@+id/empty_list_colors"
        style="@style/HeaderTree"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_24"
        android:gravity="center"
        android:text="@string/empty_list_colors"
        android:textColor="@color/app_color_onBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/button_create"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_lighting_mod" />

    <TextView
        android:id="@+id/button_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/dimen_24"
        android:layout_marginBottom="@dimen/dimen_24"
        android:background="@drawable/button_state_drawable"
        android:clickable="true"
        android:enabled="false"
        android:fontFamily="@font/geologica_auto_regular"
        android:gravity="center"
        android:paddingVertical="@dimen/dimen_12"
        android:text="@string/create"
        android:textColor="@color/app_color_onPrimary"
        android:textSize="@dimen/text_size_18s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>