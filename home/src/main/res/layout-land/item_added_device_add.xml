<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_added_device_add"
    android:layout_width="@dimen/dimen_122"
    android:layout_height="@dimen/dimen_82"
    android:layout_marginBottom="@dimen/dimen_24"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/shape_card_add_dash"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:paddingHorizontal="@dimen/dimen_16">

    <TextView
        android:id="@+id/name_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:fontFamily="@font/geologica_auto_regular"
        android:gravity="center"
        android:text="@string/add_device"
        android:textColor="@color/app_color_onSurfaceVariant"
        android:textSize="@dimen/text_size_12s"
        android:layout_marginBottom="@dimen/dimen_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/image_device"
        android:layout_width="@dimen/dimen_16"
        android:layout_height="@dimen/dimen_16"
        android:layout_marginTop="@dimen/dimen_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_device"
        app:srcCompat="@drawable/ic_bluetooth_disconnect"
        app:tint="@color/app_color_onSurfaceVariant" />

</LinearLayout>