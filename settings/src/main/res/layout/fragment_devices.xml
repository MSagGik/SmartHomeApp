<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".presentation.ui.DevicesFragment">

    <LinearLayout
        android:id="@+id/linear_layout_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:background="@color/app_color_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="@dimen/dimen_70"
            android:layout_height="@dimen/dimen_70"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:background="@android:color/transparent"
            android:foreground="@drawable/button_round_transparent"
            android:theme="@style/ButtonThemeOverlay"
            android:padding="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_1"
            android:src="@drawable/ic_back"/>

        <TextView
            android:id="@+id/header_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/HeaderTextSecond"
            android:layout_gravity="center"
            android:text="@string/header_setting"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingBottom="@dimen/dimen_122"
        app:layout_constraintTop_toBottomOf="@+id/linear_layout_one">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dimen_30"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/header_two"
                style="@style/HeaderTree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dimen_24"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/saved_devices"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_bluetooth_saved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_5"
                android:minHeight="50dp"
                android:visibility="visible"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <ProgressBar
                android:id="@+id/loading_time_saved"
                android:layout_width="@dimen/dimen_41"
                android:layout_height="@dimen/dimen_41"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/app_color_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error_message_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HeaderTwo"
                android:textColor="@color/app_color_onBackground"
                android:text="@string/error_message"
                android:layout_marginVertical="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dimen_24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/empty_list_devices_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HeaderTwo"
                android:textColor="@color/app_color_onBackground"
                android:text="@string/empty_list_devices"
                android:layout_marginVertical="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dimen_24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/header_tree"
                style="@style/HeaderTree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dimen_24"
                android:layout_marginTop="@dimen/dimen_24"
                android:text="@string/searched_devices"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_bluetooth_searched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_5"
                android:minHeight="50dp"
                android:visibility="visible"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <ProgressBar
                android:id="@+id/loading_time_searched"
                android:layout_width="@dimen/dimen_41"
                android:layout_height="@dimen/dimen_41"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/app_color_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error_message_searched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HeaderTwo"
                android:textColor="@color/app_color_onBackground"
                android:text="@string/error_message"
                android:layout_marginVertical="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dimen_24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/empty_list_devices_searched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/HeaderTwo"
                android:textColor="@color/app_color_onBackground"
                android:text="@string/empty_list_devices"
                android:layout_marginVertical="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dimen_24"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/search_device"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:backgroundTint="@color/app_color_primary"
        android:fontFamily="@font/geologica_auto_medium"
        android:textColor="@color/app_color_onPrimary"
        android:textSize="@dimen/text_size_16s"
        app:cornerRadius="@dimen/dimen_16"
        android:textAllCaps="false"
        android:text="@string/search_devices"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="25dp" />

</androidx.constraintlayout.widget.ConstraintLayout>